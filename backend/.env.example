APP_NAME=KrishiMitra
ENVIRONMENT=development
DEFAULT_DISTRICT=Pune

# Supabase: project URL, service-role key (server only!), and for legacy projects the JWT secret.
# New projects: leave SUPABASE_JWT_SECRET empty; tokens are verified via SUPABASE_URL's JWKS endpoint.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# memory (dev, lost on restart) | supabase
STORE_BACKEND=memory

VISION_LOW_CONFIDENCE=0.60
VISION_HIGH_CONFIDENCE=0.85
VISION_BACKEND=onnx
VISION_MODEL_PATH=models/soybean_vision.onnx

QUALITY_MIN_SIDE=224
QUALITY_MIN_BRIGHTNESS=40
QUALITY_MAX_BRIGHTNESS=220
QUALITY_MAX_CLIPPED_FRACTION=0.4
QUALITY_MIN_SHARPNESS=60
QUALITY_MIN_LEAF_RATIO=0.10
