# Copy to .env.local and fill in. NEXT_PUBLIC_* values are visible in the browser by design.
# Never put a Supabase service-role key or JWT secret here.

# Supabase project (Project settings -> API). The anon/publishable key is the PUBLIC one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KrishiMitra backend (FastAPI). Its CORS_ALLOWED_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Show a "Marathi draft: needs native review" badge when the UI is Marathi. On by default in development.
# Set to "false" to hide it (do this only after a native speaker has reviewed the strings).
NEXT_PUBLIC_SHOW_DRAFT_BADGES=
